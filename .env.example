# ---------------------------------------------------------------------------
# OmniScribe Studio (DaoForge) - Environment Configuration Template
# Copy this file to .env and configure for your local environment:
# cp .env.example .env
# ---------------------------------------------------------------------------

# Project Storage Paths
DATA_DIR=./data
SQLITE_FALLBACK_PATH=./data/trait_engine/traits.db
TRAIT_JSONL_LOG_PATH=./data/trait_engine/trait_evolution_log.jsonl

# PostgreSQL 16 (Container Service: omniscribe-postgres)
POSTGRES_USER=daoforge
POSTGRES_PASSWORD=daoforge_secret_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omniscribe_db

# Neo4j 5 Graph Database (Container Service: omniscribe-neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=daoforge_graph_2026
NEO4J_AUTH=neo4j/daoforge_graph_2026

# Qdrant Vector Store (Container Service: omniscribe-qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
VECTOR_COLLECTION_NAME=omniscribe_lore_chunks
EMBEDDING_DIM=1024

# Redis 7.4 Bus & Telemetry (Container Service: omniscribe-redis)
REDIS_URL=redis://localhost:6379/0

# FlareSolverr Cloudflare Bypass (Container Service: omniscribe-flaresolverr)
FLARESOLVERR_URL=http://localhost:8191/v1

# Local LLM Engine (Ollama / vLLM / LiteLLM proxy)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
DEFAULT_PROSE_MODEL=openai/qwen2.5:14b
TRANSLATION_MODEL=openai/dao-9b
UNCENSORED_MODEL=openai/dolphin-mistral-nemo:12b
FAST_TAGGER_MODEL=openai/qwen2.5:3b

# Core Gateway API Host & Port
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
